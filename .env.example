# Dev local uniquement. En prod : Key Vault / Secret Manager + identité managée, jamais de fichier .env commité.
JWT_SECRET=change-me-change-me-change-me-32chars-min
JWT_ISSUER=https://idp.example.com
JWT_AUDIENCE=mcp-gateway
RESOURCE_URL=http://localhost:8000
# Prod : remplace JWT_SECRET (RS256/ES256 via les clés publiques de l'IdP)
# JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO
# Hôtes/origines autorisés (protection DNS rebinding). Prod : le(s) domaine(s) public(s) du serveur
# ALLOWED_HOSTS=mcp.example.com
# ALLOWED_ORIGINS=https://mcp.example.com
